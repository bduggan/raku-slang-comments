#!raku

use Test;
use Slang::Comments;

plan 3;

if Raku.?legacy {
  skip-rest "requires the RakuAST frontend";
  exit;
}

unless $*RAKU.compiler.version > v2026.08 {
  skip-rest "requires Raku after version 2026.08, this is " ~ $*RAKU.compiler.version;
  exit;
}

my @got;
my $handle = $*OUT.^find_method('print').wrap(-> |x { @got.push(x) } );

for 1..10 { #= ### running
  my $x = 12;
}

$handle.restore;

ok 1, 'lives';

like @got[0].Str, / 'running' /;
like @got[1], / 'running' /;

